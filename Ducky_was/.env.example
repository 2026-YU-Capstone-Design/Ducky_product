
DB_USERNAME=rubberduck
DB_PASSWORD=

JWT_SECRET=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

CORS_ALLOWED_ORIGINS=https://실제도메인

# Cloud mode is opt-in. Supply verified infrastructure outputs and the same
# immutable processor revision as Lambda before setting DOCUMENT_MODE=cloud.
DOCUMENT_MODE=local
DOCUMENT_REGION=ap-southeast-2
DOCUMENT_BUCKET=
DOCUMENT_COMPLETION_QUEUE_URL=
RAG_PROCESSOR_REVISION=
# Deployed cloud mode requires instance-role and a reviewed backend-only role.
DOCUMENT_AWS_CREDENTIALS=
DOCUMENT_COMPLETION_POLL_ENABLED=true

# Review/apply both document-cloud and conversation-harness manual SQL scripts
# before switching an existing managed database to validate.
JPA_DDL_AUTO=update

BACKEND_IMAGE=ghcr.io/2026-yu-capstone-design/ducky-backend:main
